# =============================================================================
# Jira Integration Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Update the values below with your actual Jira credentials
# 3. Generate API token from: https://id.atlassian.com/manage-profile/security/api-tokens

# Your Jira user email address (the one you use to log into Jira)
JIRA_USER_EMAIL=your.email@company.com

# Jira API Token (generate from the link above)
JIRA_API_TOKEN=your_jira_api_token_here

# Your Jira base URL (e.g., https://yourcompany.atlassian.net)
JIRA_BASE_URL=https://yourcompany.atlassian.net

# The key of the Jira project you want to fetch issues from
# You can find this in your Jira project settings or in issue keys (e.g., KAN-123 -> project key is "KAN")
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
