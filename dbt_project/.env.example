# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Snowflake Database Connection
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=ANALYTICS_DEV
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=DBT_DEV

# Production Environment (if different)
SNOWFLAKE_PROD_USER=your_prod_username
SNOWFLAKE_PROD_PASSWORD=your_prod_password
SNOWFLAKE_PROD_ROLE=TRANSFORMER_PROD
SNOWFLAKE_PROD_DATABASE=ANALYTICS_PROD
SNOWFLAKE_PROD_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PROD_SCHEMA=DBT_PROD

# dbt Configuration
DBT_PROFILES_DIR=./
DBT_PROJECT_DIR=./

# Logging
DBT_LOG_LEVEL=info
